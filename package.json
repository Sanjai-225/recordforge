{
  "name": "recordforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:db": "node --import tsx tests/database.test.ts",
    "test:load": "node --import tsx tests/load.test.ts",
    "test:browser": "node --import tsx tests/run-browser.ts",
    "bootstrap:developer": "node --import tsx scripts/bootstrap-developer.ts",
    "seed": "node --import tsx scripts/seed.ts",
    "test:provider": "node --import tsx tests/provider.test.ts",
    "test:concurrency": "node --import tsx tests/concurrency.postgres.ts",
    "migrate": "node --import tsx scripts/apply-migrations.ts",
    "accounts:retired": "node --import tsx scripts/retired-accounts.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "pg": "8.23.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
